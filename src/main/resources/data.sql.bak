-- Событие 1: Spring Conference 2024
INSERT INTO sessions (id, title, description, start_time, end_time, max_capacity, current_participants, event_id, speaker_id) VALUES
(1, 'Spring Boot 3: Новые возможности', 'Подробный обзор новых функций в Spring Boot 3, миграция с версии 2.x, best practices.', '2024-05-15 10:00:00', '2024-05-15 11:30:00', 100, 0, 1, 1),
(2, 'Микросервисы на практике', 'Реальные кейсы построения микросервисной архитектуры: от монолита к микросервисам.', '2024-05-15 12:00:00', '2024-05-15 13:30:00', 80, 0, 1, 2),
(3, 'Безопасность в Spring приложениях', 'Лучшие практики по обеспечению безопасности: аутентификация, авторизация, защита от уязвимостей.', '2024-05-16 10:00:00', '2024-05-16 11:30:00', 120, 0, 1, 3),
(4, 'Reactive Spring', 'Разработка реактивных приложений с использованием Spring WebFlux и Project Reactor.', '2024-05-16 14:00:00', '2024-05-16 15:30:00', 90, 0, 1, 1),
(5, 'Тестирование Spring приложений', 'Unit, integration и end-to-end тестирование. MockMvc, Testcontainers, Spring Boot Test.', '2024-05-17 11:00:00', '2024-05-17 12:30:00', 70, 0, 1, 2);

-- Событие 2: Java Summit 2024
INSERT INTO sessions (id, title, description, start_time, end_time, max_capacity, current_participants, event_id, speaker_id) VALUES
(6, 'Java 21: Новые функции', 'Обзор нововведений в Java 21: виртуальные потоки, pattern matching, record patterns.', '2024-06-10 11:00:00', '2024-06-10 12:30:00', 150, 0, 2, 1),
(7, 'Оптимизация производительности Java приложений', 'Профилирование, диагностика проблем с памятью, настройка JVM.', '2024-06-10 14:00:00', '2024-06-10 15:30:00', 100, 0, 2, 2),
(8, 'Многопоточность в Java', 'Concurrent collections, CompletableFuture, новые подходы к параллелизму.', '2024-06-11 10:00:00', '2024-06-11 11:30:00', 120, 0, 2, 1),
(9, 'Java в облаке', 'Развертывание Java приложений в Kubernetes, service mesh, cloud-native подходы.', '2024-06-11 13:00:00', '2024-06-11 14:30:00', 90, 0, 2, 5);

